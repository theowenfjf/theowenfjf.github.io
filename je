<title>oc chicken</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
  /* Layout: one centered column over a starfield. Hero with a live-style mock of the menu, then features, install steps, and the script itself. */
  :root {
    --bg: #080821;
    --bg-2: #241049;
    --bg-3: #0b2a52;
    --fg: #e9e4ff;
    --muted: #b8aef0;
    --line: rgba(109, 74, 255, .5);
    --panel: #1b1442;
    --violet: #6d4aff;
    --pink: #f472b6;
    --blue: #60a5fa;
    --green: #22c55e;
    --amber: #f59e0b;
    --off: #3a3560;
    --off-fg: #aaa3d6;
    --display: "Unbounded", "Trebuchet MS", system-ui, sans-serif;
    --body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    color-scheme: dark;
  }

  html { background: var(--bg); }
  body {
    margin: 0;
    background:
      radial-gradient(1px 1px at 12% 18%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 78% 9%, #cfe8ff, transparent),
      radial-gradient(1px 1px at 41% 31%, #fff, transparent),
      radial-gradient(1px 1px at 90% 44%, #ffd6f5, transparent),
      radial-gradient(1.5px 1.5px at 24% 62%, #fff, transparent),
      radial-gradient(1px 1px at 63% 77%, #fff, transparent),
      radial-gradient(1px 1px at 8% 91%, #cfe8ff, transparent),
      radial-gradient(ellipse at 15% 0%, rgba(168, 85, 247, .38), transparent 55%),
      radial-gradient(ellipse at 95% 100%, rgba(56, 189, 248, .28), transparent 50%),
      linear-gradient(165deg, var(--bg), var(--bg-2) 55%, var(--bg-3));
    background-color: var(--bg);
    color: var(--fg);
    font: 16px/1.6 var(--body);
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    padding-block: 48px 72px;
  }
  .wrap { max-width: 880px; margin: 0 auto; display: grid; gap: 56px; }
  h1, h2, h3 { text-wrap: balance; margin: 0; }
  p { margin: 0; }
  a { color: var(--blue); }
  :focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }

  /* hero */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 40px; align-items: center; }
  .hero h1 {
    font: 700 clamp(2.2rem, 7vw, 3.6rem)/1.05 var(--display);
    letter-spacing: -.01em;
    text-shadow: 0 0 22px rgba(167, 139, 250, .85);
  }
  .hero .lede { margin-top: 18px; color: var(--muted); font-size: 1.08rem; max-width: 46ch; }
  .tags { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font: 500 12px/1 var(--mono); letter-spacing: .04em;
    padding: 7px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted);
  }
  .cta { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .btn {
    font: 700 14px/1 var(--body); cursor: pointer; border: none; border-radius: 8px;
    padding: 12px 18px; color: #04210f; background: var(--green);
    box-shadow: 0 0 14px var(--green);
  }
  .btn.alt { background: var(--panel); color: var(--fg); border: 1px solid var(--violet); box-shadow: none; }
  .btn:active { transform: translateY(1px); }

  /* static mock of the in-page menu */
  .mock {
    width: 230px; justify-self: center; box-sizing: border-box;
    border: 1px solid var(--violet); border-radius: 14px; overflow: hidden;
    box-shadow: 0 0 18px rgba(124, 77, 255, .55), 0 0 40px rgba(56, 189, 248, .25);
    background:
      radial-gradient(1px 1px at 18px 24px, #fff, transparent),
      radial-gradient(1.5px 1.5px at 70px 60px, #cfe8ff, transparent),
      radial-gradient(1px 1px at 160px 90px, #ffd6f5, transparent),
      radial-gradient(ellipse at 20% 0%, rgba(168, 85, 247, .45), transparent 60%),
      linear-gradient(160deg, #080821, #241049 55%, #0b2a52);
    background-color: var(--bg);
    font: 13px/1.4 system-ui, sans-serif;
  }
  .mock .head { padding: 9px 12px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; }
  .mock .head b { text-shadow: 0 0 8px #a78bfa; letter-spacing: .5px; }
  .mock .body { padding: 12px; display: grid; gap: 9px; }
  .mock .mbtn { padding: 8px; border-radius: 8px; font-weight: 700; font-size: 14px; text-align: center; }
  .mock .row { display: flex; justify-content: space-between; align-items: center; }
  .mock .key { min-width: 70px; text-align: center; background: var(--panel); border: 1px solid var(--violet); border-radius: 6px; padding: 3px 6px; }
  .mock .small { color: var(--muted); font-size: 12px; }
  .mock hr { border: none; border-top: 1px solid var(--line); width: 100%; margin: 2px 0; }
  .mock .sel { padding: 7px; border-radius: 8px; background: var(--panel); border: 1px solid var(--violet); }

  /* sections */
  .eyebrow { font: 500 12px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--pink); }
  h2 { font: 700 1.5rem/1.2 var(--display); margin-top: 10px; }
  .section-lede { margin-top: 10px; color: var(--muted); max-width: 60ch; }

  .features { margin-top: 24px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .feat { min-width: 0; padding: 18px; border: 1px solid var(--line); border-radius: 12px; background: rgba(27, 20, 66, .55); }
  .feat h3 { font: 600 1rem/1.3 var(--body); display: flex; align-items: center; gap: 10px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .feat p { margin-top: 8px; color: var(--muted); font-size: .95rem; }
  .feat code, .steps code, .notes code {
    font: 400 .85em var(--mono); background: rgba(109, 74, 255, .22); padding: 1px 6px; border-radius: 5px; color: var(--fg);
  }

  .steps { margin: 24px 0 0; padding: 0; list-style: none; display: grid; gap: 14px; counter-reset: s; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 14px; align-items: start; }
  .steps li::before {
    content: counter(s); font: 700 14px/34px var(--display); text-align: center; width: 34px; height: 34px;
    border: 1px solid var(--violet); border-radius: 50%; color: var(--pink);
  }
  .steps li p { padding-top: 5px; }
  kbd { font: 500 .85em var(--mono); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; padding: 1px 6px; background: var(--panel); }

  /* script block */
  .codebar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 22px; }
  .codebar .meta { font: 400 12px/1.4 var(--mono); color: var(--muted); }
  .codebox {
    margin-top: 12px; border: 1px solid var(--violet); border-radius: 12px; background: #0a0a26;
    box-shadow: 0 0 24px rgba(124, 77, 255, .3);
    overflow: auto; max-height: 440px;
  }
  .codebox pre { margin: 0; padding: 16px 18px; font: 400 12.5px/1.55 var(--mono); color: #d8d2ff; tab-size: 2; }
  .toast { font: 500 13px/1 var(--mono); color: var(--green); min-height: 1em; }

  .notes { margin-top: 20px; padding: 18px; border: 1px solid var(--amber); border-radius: 12px; background: rgba(245, 158, 11, .08); display: grid; gap: 8px; color: var(--fg); }
  .notes b { color: var(--amber); }

  footer { color: var(--muted); font: 400 12px/1.6 var(--mono); border-top: 1px solid var(--line); padding-top: 20px; }

  @media (max-width: 720px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .mock { justify-self: start; }
    .features { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>

<main class="wrap">
  <header class="hero">
    <div>
      <h1>✦ oc chicken ✦</h1>
      <p class="lede">A small floating menu you paste into the page. It taps Space for exactly 478 ms, runs the J / L combos on one key, and can block for you when the opponent holds a button.</p>
      <div class="tags">
        <span class="tag">478 ms Space hold</span>
        <span class="tag">3 combos</span>
        <span class="tag">Auto Block</span>
        <span class="tag">rebindable keys</span>
      </div>
      <div class="cta">
        <button class="btn" id="copy-top" type="button">Copy script</button>
        <a class="btn alt" href="#get" style="text-decoration:none">Install steps</a>
      </div>
    </div>

    <div class="mock" aria-label="Preview of the menu">
      <div class="head"><b>✦ oc chicken ✦</b><span>–</span></div>
      <div class="body">
        <div class="mbtn" style="background:var(--green);color:#04210f;box-shadow:0 0 12px var(--green)">Green: ON</div>
        <div class="row">Green key <span class="key">X</span></div>
        <div class="small">Hold: 478 ms (locked)</div>
        <hr>
        <div class="sel">All-in-one</div>
        <div class="mbtn" style="background:var(--pink);color:#3b0a24;box-shadow:0 0 12px var(--pink)">All-in-one: ON</div>
        <div class="row">Key <span class="key">N</span></div>
        <div class="small">Sends: L → J → J → J → L → J → K</div>
        <hr>
        <div class="mbtn" style="background:var(--amber);color:#2b1700;box-shadow:0 0 12px var(--amber)">Auto Block: ON</div>
        <div class="small">Blocks (L) if opp holds &gt; 100ms</div>
      </div>
    </div>
  </header>

  <section>
    <div class="eyebrow">What you get</div>
    <h2>Four buttons, one menu</h2>
    <p class="section-lede">Every button has its own on/off switch. Drag the header to move the menu, or press the dash to shrink it. Your choices are saved in the browser.</p>
    <div class="features">
      <div class="feat">
        <h3><span class="dot" style="background:var(--green);box-shadow:0 0 8px var(--green)"></span>Green</h3>
        <p>One press of <code>X</code> holds Space for 478 ms, timed with a short busy-wait at the end so the length stays tight.</p>
      </div>
      <div class="feat">
        <h3><span class="dot" style="background:var(--pink);box-shadow:0 0 8px var(--pink)"></span>All-in-one</h3>
        <p>Press <code>N</code> to send L J J, then J L J, then K. Each key is held 50 ms with a 50 ms gap.</p>
      </div>
      <div class="feat">
        <h3><span class="dot" style="background:var(--blue);box-shadow:0 0 8px var(--blue)"></span>Combo 1 and Combo 2</h3>
        <p>Combo 1 is J L J on <code>K</code>. Combo 2 is L J J on <code>M</code>. Pick one in the dropdown and rebind its key.</p>
      </div>
      <div class="feat">
        <h3><span class="dot" style="background:var(--amber);box-shadow:0 0 8px var(--amber)"></span>Auto Block</h3>
        <p>Watches the match connection. When the opponent starts a hold and is still holding after 100 ms, it presses your block key. A quick tap does nothing.</p>
      </div>
    </div>
  </section>

  <section id="get">
    <div class="eyebrow">Install</div>
    <h2>Paste it into the console</h2>
    <ol class="steps">
      <li><p>Refresh the game page. This clears any earlier copy of the script that is still running.</p></li>
      <li><p>Press <kbd>F12</kbd> and open the <b>Console</b> tab.</p></li>
      <li><p>Copy the script below, paste it into the console, and press <kbd>Enter</kbd>. The menu appears in the top right.</p></li>
      <li><p>Start a match and make one move. Auto Block attaches to the match connection once the match is running, and the console prints <code>[autoBlock] attached to match socket</code>.</p></li>
    </ol>

    <div class="codebar">
      <div class="meta">oc-chicken.js · 292 lines · plain JavaScript, no install</div>
      <div style="display:flex;gap:12px;align-items:center">
        <span class="toast" id="toast" role="status" aria-live="polite"></span>
        <button class="btn" id="copy" type="button">Copy script</button>
      </div>
    </div>
    <div class="codebox" id="codebox" tabindex="0"><pre><code id="src">(() =&gt; {
  if (window.__spaceTapMenu) { window.__spaceTapMenu.remove(); }

  // ---------- locked timing (edit here in the code only) ----------
  const HOLD_MS = 478;        // space tap hold
  const SPIN_MS = 6;          // last few ms timed by a tight loop for accuracy
  const COMBO_PRESS_MS = 50;  // how long each combo key is held
  const COMBO_GAP_MS = 50;    // pause between keys

  // ---------- auto block settings (PUT YOUR ORIGINAL cfg VALUES HERE) ----------
  // Blocks only when the opponent's hold lasts longer than AB_MIN_HOLD_MS:
  // on "holdStart" a timer starts; a "holdEnd" before it fires cancels the block.
  const AB_KEY = "l";           // key that blocks
  const AB_MIN_HOLD_MS = 100;   // opponent must hold past this long
  const AB_PRESS_MS = 90;       // how long block is held

  // ---------- actions ----------
  const press = (k, hold = COMBO_PRESS_MS) =&gt; ({ k, hold });
  const C1 = [press("j"), press("l"), press("j")];
  const C2 = [press("l"), press("j"), press("j")];

  // Green is NOT in the dropdown (inDropdown: false), it has its own button
  const ENTRIES = [
    { id: "green", name: "Green", steps: [press(" ", HOLD_MS)], defaultKey: "x", color: "#22c55e", text: "#04210f", inDropdown: false },
    { id: "all",   name: "All-in-one",      steps: [...C2, ...C1, press("k")], defaultKey: "n", color: "#f472b6", text: "#3b0a24", inDropdown: true },
    { id: "c1",    name: "Combo 1 (J L J)", steps: C1,             defaultKey: "k", color: "#60a5fa", text: "#05142e", inDropdown: true },
    { id: "c2",    name: "Combo 2 (L J J)", steps: C2,             defaultKey: "m", color: "#c084fc", text: "#1a0633", inDropdown: true },
  ];
  const GREEN = ENTRIES.find((e) =&gt; e.id === "green");
  const DROPDOWN = ENTRIES.filter((e) =&gt; e.inDropdown);
  const AB_COLOR = "#f59e0b", AB_TEXT = "#2b1700";

  // ---------- saved settings ----------
  let cfg = { minimized: false, selected: "all", entries: {}, autoBlock: true };
  ENTRIES.forEach((e) =&gt; { cfg.entries[e.id] = { enabled: true, key: e.defaultKey }; });
  try {
    const saved = JSON.parse(localStorage.getItem("spaceTapCfg6") || "{}");
    if (typeof saved.minimized === "boolean") cfg.minimized = saved.minimized;
    if (typeof saved.autoBlock === "boolean") cfg.autoBlock = saved.autoBlock;
    if (DROPDOWN.some((e) =&gt; e.id === saved.selected)) cfg.selected = saved.selected;
    ENTRIES.forEach((e) =&gt; { if (saved.entries &amp;&amp; saved.entries[e.id]) Object.assign(cfg.entries[e.id], saved.entries[e.id]); });
  } catch {}
  const save = () =&gt; { try { localStorage.setItem("spaceTapCfg6", JSON.stringify(cfg)); } catch {} };

  // ---------- menu UI (galaxy theme) ----------
  const box = document.createElement("div");
  window.__spaceTapMenu = box;
  box.style.cssText = `
    position:fixed; top:20px; right:20px; z-index:2147483647; width:230px;
    color:#e9e4ff; font:13px system-ui,sans-serif; user-select:none;
    border:1px solid #6d4aff; border-radius:14px; overflow:hidden;
    box-shadow:0 0 18px rgba(124,77,255,.55), 0 0 40px rgba(56,189,248,.25);
    background:
      radial-gradient(1px 1px at 18px 24px,#fff,transparent),
      radial-gradient(1.5px 1.5px at 70px 60px,#cfe8ff,transparent),
      radial-gradient(1px 1px at 120px 20px,#fff,transparent),
      radial-gradient(1px 1px at 160px 90px,#ffd6f5,transparent),
      radial-gradient(1.5px 1.5px at 200px 40px,#fff,transparent),
      radial-gradient(1px 1px at 40px 110px,#fff,transparent),
      radial-gradient(ellipse at 20% 0%,rgba(168,85,247,.45),transparent 60%),
      radial-gradient(ellipse at 90% 100%,rgba(56,189,248,.35),transparent 55%),
      linear-gradient(160deg,#080821,#241049 55%,#0b2a52);
    background-size:230px 130px,230px 130px,230px 130px,230px 130px,230px 130px,230px 130px,100% 100%,100% 100%,100% 100%;`;

  const btnStyle = "cursor:pointer;padding:8px;border:none;border-radius:8px;font-weight:700;font-size:14px;";
  const smallBtn = "min-width:70px;cursor:pointer;background:#1b1442;color:#e9e4ff;border:1px solid #6d4aff;border-radius:6px;padding:3px 6px;";

  box.innerHTML = `
    &lt;div id="st-head" style="padding:9px 12px;cursor:move;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(109,74,255,.5);"&gt;
      &lt;b style="letter-spacing:.5px;text-shadow:0 0 8px #a78bfa;"&gt;✦ oc chicken ✦&lt;/b&gt;
      &lt;span id="st-min" style="cursor:pointer;padding:0 4px;"&gt;–&lt;/span&gt;
    &lt;/div&gt;
    &lt;div id="st-body" style="padding:12px;display:grid;gap:9px;"&gt;
      &lt;button id="st-green" style="${btnStyle}"&gt;&lt;/button&gt;
      &lt;div style="display:flex;justify-content:space-between;align-items:center;"&gt;
        Green key &lt;button id="st-gkey" style="${smallBtn}"&gt;&lt;/button&gt;
      &lt;/div&gt;
      &lt;div style="color:#b8aef0;font-size:12px;"&gt;Hold: ${HOLD_MS} ms (locked)&lt;/div&gt;

      &lt;hr style="border:none;border-top:1px solid rgba(109,74,255,.5);width:100%;margin:2px 0;"&gt;

      &lt;select id="st-sel" style="padding:7px;border-radius:8px;background:#1b1442;color:#e9e4ff;border:1px solid #6d4aff;font-size:13px;cursor:pointer;"&gt;
        ${DROPDOWN.map((e) =&gt; `&lt;option value="${e.id}"&gt;${e.name}&lt;/option&gt;`).join("")}
      &lt;/select&gt;
      &lt;button id="st-toggle" style="${btnStyle}"&gt;&lt;/button&gt;
      &lt;div style="display:flex;justify-content:space-between;align-items:center;"&gt;
        Key &lt;button id="st-key" style="${smallBtn}"&gt;&lt;/button&gt;
      &lt;/div&gt;
      &lt;div id="st-seq" style="color:#b8aef0;font-size:12px;"&gt;&lt;/div&gt;
      &lt;div id="st-last" style="color:#8fd3ff;font-size:12px;"&gt;Last run: –&lt;/div&gt;

      &lt;hr style="border:none;border-top:1px solid rgba(109,74,255,.5);width:100%;margin:2px 0;"&gt;

      &lt;button id="st-ab" style="${btnStyle}"&gt;&lt;/button&gt;
      &lt;div id="st-abinfo" style="color:#b8aef0;font-size:12px;"&gt;&lt;/div&gt;
    &lt;/div&gt;`;
  document.body.appendChild(box);

  const $ = (id) =&gt; box.querySelector("#" + id);
  const greenBtn = $("st-green"), gKeyBtn = $("st-gkey");
  const selEl = $("st-sel"), toggleBtn = $("st-toggle"), keyBtn = $("st-key");
  const seqEl = $("st-seq"), lastEl = $("st-last"), bodyEl = $("st-body");
  const abBtn = $("st-ab"), abInfo = $("st-abinfo");

  let rebinding = null; // entry id | null
  const label = (k) =&gt; (k === " " ? "Space" : k.toUpperCase());
  const seqText = (e) =&gt; e.steps.map((s) =&gt; s.k.toUpperCase()).join(" → ");

  const refresh = () =&gt; {
    // Green (outside the dropdown)
    const gs = cfg.entries.green;
    greenBtn.textContent = gs.enabled ? "Green: ON" : "Green: OFF";
    greenBtn.style.background = gs.enabled ? GREEN.color : "#3a3560";
    greenBtn.style.color = gs.enabled ? GREEN.text : "#aaa3d6";
    greenBtn.style.boxShadow = gs.enabled ? `0 0 12px ${GREEN.color}` : "none";
    gKeyBtn.textContent = rebinding === "green" ? "press a key…" : label(gs.key);

    // dropdown entry
    const e = DROPDOWN.find((x) =&gt; x.id === cfg.selected);
    const s = cfg.entries[e.id];
    selEl.value = e.id;
    toggleBtn.textContent = `${e.name.split(" (")[0]}: ${s.enabled ? "ON" : "OFF"}`;
    toggleBtn.style.background = s.enabled ? e.color : "#3a3560";
    toggleBtn.style.color = s.enabled ? e.text : "#aaa3d6";
    toggleBtn.style.boxShadow = s.enabled ? `0 0 12px ${e.color}` : "none";
    keyBtn.textContent = rebinding === e.id ? "press a key…" : label(s.key);
    seqEl.textContent = "Sends: " + seqText(e);

    // auto block (outside the dropdown)
    abBtn.textContent = cfg.autoBlock ? "Auto Block: ON" : "Auto Block: OFF";
    abBtn.style.background = cfg.autoBlock ? AB_COLOR : "#3a3560";
    abBtn.style.color = cfg.autoBlock ? AB_TEXT : "#aaa3d6";
    abBtn.style.boxShadow = cfg.autoBlock ? `0 0 12px ${AB_COLOR}` : "none";
    abInfo.textContent = `Blocks (${label(AB_KEY)}) if opp holds &gt; ${AB_MIN_HOLD_MS}ms`;

    bodyEl.style.display = cfg.minimized ? "none" : "grid";
    $("st-min").textContent = cfg.minimized ? "+" : "–";
  };
  refresh();

  greenBtn.onclick = () =&gt; { cfg.entries.green.enabled = !cfg.entries.green.enabled; save(); refresh(); };
  gKeyBtn.onclick = () =&gt; { rebinding = "green"; refresh(); };
  selEl.onchange = () =&gt; { cfg.selected = selEl.value; rebinding = null; save(); refresh(); };
  toggleBtn.onclick = () =&gt; { const s = cfg.entries[cfg.selected]; s.enabled = !s.enabled; save(); refresh(); };
  keyBtn.onclick = () =&gt; { rebinding = cfg.selected; refresh(); };
  abBtn.onclick = () =&gt; { cfg.autoBlock = !cfg.autoBlock; save(); refresh(); };
  $("st-min").onclick = () =&gt; { cfg.minimized = !cfg.minimized; save(); refresh(); };

  // drag the menu by its header
  let drag = null;
  $("st-head").onmousedown = (e) =&gt; {
    if (e.target.id === "st-min") return;
    const r = box.getBoundingClientRect();
    drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
  };
  document.addEventListener("mousemove", (e) =&gt; {
    if (!drag) return;
    box.style.left = e.clientX - drag.dx + "px";
    box.style.top = e.clientY - drag.dy + "px";
    box.style.right = "auto";
  });
  document.addEventListener("mouseup", () =&gt; { drag = null; });

  // ---------- key event helpers ----------
  const keyInfo = (k) =&gt;
    k === " "
      ? { key: " ", code: "Space", keyCode: 32 }
      : { key: k, code: "Key" + k.toUpperCase(), keyCode: k.toUpperCase().charCodeAt(0) };

  const keyEvent = (type, k) =&gt; {
    const { key, code, keyCode } = keyInfo(k);
    return new KeyboardEvent(type, { key, code, keyCode, which: keyCode, bubbles: true, cancelable: true });
  };

  const getTarget = () =&gt; {
    const t = document.activeElement || document.body;
    return box.contains(t) ? document.body : t;
  };

  const sleep = (ms) =&gt; new Promise((r) =&gt; setTimeout(r, ms));

  // precise hold: sleep most of it, spin for the last few ms
  async function preciseWait(ms) {
    const end = performance.now() + ms;
    await sleep(Math.max(0, ms - SPIN_MS));
    while (performance.now() &lt; end) {}
  }

  // ---------- runner (one action at a time) ----------
  let running = false;
  const keysDown = new Set();

  async function runEntry(entry) {
    if (running) return;
    running = true;
    const target = getTarget();
    const t0 = performance.now();
    try {
      for (let i = 0; i &lt; entry.steps.length; i++) {
        const { k, hold } = entry.steps[i];
        target.dispatchEvent(keyEvent("keydown", k));
        await preciseWait(hold);
        target.dispatchEvent(keyEvent("keyup", k));
        if (k === " ") document.dispatchEvent(keyEvent("keyup", k));
        if (i &lt; entry.steps.length - 1) await sleep(COMBO_GAP_MS);
      }
    } finally {
      running = false;
      lastEl.textContent = `Last run: ${(performance.now() - t0).toFixed(0)} ms`;
    }
  }

  // ---------- listeners ----------
  const onKeyDown = (e) =&gt; {
    if (!e.isTrusted) return; // ignore our own synthetic keys so nothing loops

    if (rebinding) {
      e.preventDefault();
      if (e.key !== "Escape") cfg.entries[rebinding].key = e.key.toLowerCase();
      rebinding = null;
      save(); refresh();
      return;
    }
    if (box.contains(e.target)) return;

    const k = e.key.toLowerCase();
    for (const en of ENTRIES) {
      const s = cfg.entries[en.id];
      if (s.enabled &amp;&amp; k === s.key &amp;&amp; !keysDown.has(en.id)) {
        keysDown.add(en.id);   // one tap = one run, ignores key repeat
        e.preventDefault();
        runEntry(en);
        return;
      }
    }
  };
  const onKeyUp = (e) =&gt; {
    if (!e.isTrusted) return;
    const k = e.key.toLowerCase();
    ENTRIES.forEach((en) =&gt; { if (k === cfg.entries[en.id].key) keysDown.delete(en.id); });
  };
  document.addEventListener("keydown", onKeyDown, true);
  document.addEventListener("keyup", onKeyUp, true);

  // ---------- auto block (match socket hook) ----------
  function blockPress() {
    const { key, code, keyCode } = keyInfo(AB_KEY);
    const o = { key, code, keyCode, which: keyCode, bubbles: true, cancelable: true };
    const fire = (type) =&gt; { for (const t of [window, document]) t.dispatchEvent(new KeyboardEvent(type, o)); };
    fire("keydown");
    setTimeout(() =&gt; fire("keyup"), AB_PRESS_MS);
  }

  // if the script was loaded before, restore the original send first so hooks don't stack
  if (window.__abOrigSend) WebSocket.prototype.send = window.__abOrigSend;
  const origSend = WebSocket.prototype.send;
  window.__abOrigSend = origSend;

  let holdTimer = null;
  const seen = new WeakSet();
  WebSocket.prototype.send = function (d) {
    if (!seen.has(this) &amp;&amp; /\/matches\//.test(this.url)) {
      seen.add(this);
      console.log("[autoBlock] attached to match socket");
      this.addEventListener("message", (ev) =&gt; {
        if (!cfg.autoBlock || typeof ev.data !== "string") return; // toggle checked live
        let m; try { m = JSON.parse(ev.data); } catch { return; }
        if (m.type !== "input" || !Array.isArray(m.a)) return;
        for (const x of m.a) {
          if (x.t === "holdStart") {
            clearTimeout(holdTimer);
            holdTimer = setTimeout(blockPress, AB_MIN_HOLD_MS);
          } else if (x.t === "holdEnd") {
            clearTimeout(holdTimer);   // released before the threshold -&gt; no block
          }
        }
      });
    }
    return origSend.call(this, d);
  };
  console.log("[autoBlock] ready. Move once after the match starts.");

  // call window.__spaceTapMenu.remove() to unload everything
  const origRemove = box.remove.bind(box);
  box.remove = () =&gt; {
    document.removeEventListener("keydown", onKeyDown, true);
    document.removeEventListener("keyup", onKeyUp, true);
    if (WebSocket.prototype.send !== origSend) WebSocket.prototype.send = origSend;
    window.__abOrigSend = null;
    origRemove();
  };
})();</code></pre></div>

    <div class="notes">
      <p><b>Set your block key.</b> Near the top of the script, <code>AB_KEY</code> is <code>"l"</code> as a placeholder. Change it to the key your game uses to block. <code>AB_MIN_HOLD_MS</code> sets the 100 ms threshold.</p>
      <p><b>Take it out.</b> Run <code>window.__spaceTapMenu.remove()</code> in the console, or refresh the page.</p>
